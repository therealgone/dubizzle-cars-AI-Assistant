  <diagram name="Architecture" id="arch1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== HEADER ===================== -->
        <mxCell id="title" value="Car Shopping Assistant &#8212; System Architecture" style="text;html=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#1A2233;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="16" width="1180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="FastAPI + Streamlit assistant over a car listings inventory &#8212; hybrid Chroma/BM25 search, two-track memory." style="text;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#56607A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="48" width="1180" height="24" as="geometry" />
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="leg1" value="&#9632; Data &amp; storage" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#2563EB;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="86" width="190" height="22" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="&#9632; LLM / orchestration" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#7C3AED;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="215" y="86" width="190" height="22" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="&#9632; Tool / function" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#059669;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="410" y="86" width="190" height="22" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="&#9632; Guardrail / safety" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#E11D48;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="605" y="86" width="190" height="22" as="geometry" />
        </mxCell>
        <mxCell id="leg5" value="&#9632; Memory / cache" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#D97706;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="86" width="190" height="22" as="geometry" />
        </mxCell>
        <mxCell id="leg6" value="&#9632; Frontend / UI" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0D9488;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="995" y="86" width="190" height="22" as="geometry" />
        </mxCell>

        <!-- ===================== PHASE 1 CONTAINER ===================== -->
        <mxCell id="bg1" value="" style="rounded=1;arcSize=3;dashed=1;dashPattern=6 4;strokeColor=#B9C0CF;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="140" width="1180" height="630" as="geometry" />
        </mxCell>
        <mxCell id="tag1" value="PHASE 1 &#8212; OFFLINE DATA INGESTION (runs once)" style="rounded=1;arcSize=40;fillColor=#F7F8FA;strokeColor=#DFE3EA;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#56607A;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="128" width="440" height="26" as="geometry" />
        </mxCell>

        <!-- Phase 1 nodes -->
        <mxCell id="n_dataset" value="&lt;b&gt;&lt;font color=&quot;#2563EB&quot;&gt;cars_dataset.xlsx&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;&quot;Cleaned dataset&quot; sheet &#8212; 100 listings. The &quot;raw dataset&quot; sheet is a different set of listings; not cross-referenced.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#EAF1FF;strokeColor=#BCD2FB;" vertex="1" parent="1">
          <mxGeometry x="390" y="180" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_loader" value="&lt;b&gt;&lt;font color=&quot;#059669&quot;&gt;data_loader.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;ETL &#8212; reads the sheet, runs the enrichment steps below, writes to Chroma.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#E9F8F1;strokeColor=#B9E6CF;" vertex="1" parent="1">
          <mxGeometry x="390" y="280" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n_price" value="&lt;b&gt;&lt;font color=&quot;#2563EB&quot;&gt;price_aed&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Regex-extracted. Distinguishes monthly installment figures from actual cash price. Nullable &#8212; never guessed if absent (~13/100 have it).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#EAF1FF;strokeColor=#BCD2FB;" vertex="1" parent="1">
          <mxGeometry x="170" y="380" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_body" value="&lt;b&gt;&lt;font color=&quot;#7C3AED&quot;&gt;body_style&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;One-time LLM batch classification (enrichment.py), reading full listing context. Fixed taxonomy. Nullable if genuinely ambiguous.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#F4EFFF;strokeColor=#D9C9FB;" vertex="1" parent="1">
          <mxGeometry x="470" y="380" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_search" value="&lt;b&gt;&lt;font color=&quot;#2563EB&quot;&gt;search_text&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;= make + model + trim + title + description &#8212; every field, so a trim-level query like &quot;C200&quot; is reachable.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#EAF1FF;strokeColor=#BCD2FB;" vertex="1" parent="1">
          <mxGeometry x="770" y="380" width="280" height="130" as="geometry" />
        </mxCell>

        <mxCell id="n_chroma1" value="&lt;b&gt;&lt;font color=&quot;#2563EB&quot;&gt;Chroma collection &quot;cars&quot; &#8212; single source of truth&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Per listing: &lt;b&gt;metadata&lt;/b&gt; (listing_id, year, make, model, trim, body_style, price_aed, photo_url) + &lt;b&gt;embedding&lt;/b&gt; of search_text.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#EAF1FF;strokeColor=#BCD2FB;" vertex="1" parent="1">
          <mxGeometry x="350" y="540" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_bm25" value="&lt;b&gt;&lt;font color=&quot;#2563EB&quot;&gt;BM25 keyword index (rank_bm25)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Separate index &#8212; a vector DB doesn&#39;t do word-frequency keyword matching on its own.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#EAF1FF;strokeColor=#BCD2FB;" vertex="1" parent="1">
          <mxGeometry x="350" y="680" width="520" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== PHASE 2 CONTAINER ===================== -->
        <mxCell id="bg2" value="" style="rounded=1;arcSize=3;dashed=1;dashPattern=6 4;strokeColor=#B9C0CF;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="800" width="1180" height="1540" as="geometry" />
        </mxCell>
        <mxCell id="tag2" value="PHASE 2 &#8212; ONE LIVE CHAT TURN" style="rounded=1;arcSize=40;fillColor=#F7F8FA;strokeColor=#DFE3EA;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#56607A;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="788" width="320" height="26" as="geometry" />
        </mxCell>

        <mxCell id="n_user" value="&lt;b&gt;&lt;font color=&quot;#0D9488&quot;&gt;User &#8212; Streamlit&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Types a message; car results render as photo cards.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#E7FBF8;strokeColor=#B7E9E2;" vertex="1" parent="1">
          <mxGeometry x="390" y="850" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n_session" value="&lt;b&gt;&lt;font color=&quot;#D97706&quot;&gt;FastAPI &#8594; Session Manager&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Loads session_cache.json:&lt;br&gt;&#8226; current_active_filters&lt;br&gt;&#8226; recent_logs &#8212; last &#8804;6 event summaries&lt;br&gt;&#8226; car_stack &#8212; last &#8804;6 cars shown&lt;br&gt;&#8226; selected_car &#8212; the one car in focus&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#FFF4E5;strokeColor=#F6D9A8;" vertex="1" parent="1">
          <mxGeometry x="330" y="940" width="560" height="150" as="geometry" />
        </mxCell>

        <mxCell id="n_sysprompt" value="&lt;b&gt;&lt;font color=&quot;#E11D48&quot;&gt;System Prompt Builder&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Guardrails baked in: no-hallucination rule, no-competitor-mention, off-topic scope refusal &#8212; plus the memory above injected as context.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#FFEDF1;strokeColor=#F6BFCD;" vertex="1" parent="1">
          <mxGeometry x="330" y="1120" width="560" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n_llm1" value="&lt;b&gt;&lt;font color=&quot;#7C3AED&quot;&gt;LLM Orchestrator &#8212; Gemini via LiteLLM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Decides: reply directly, or call a tool.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#F4EFFF;strokeColor=#D9C9FB;" vertex="1" parent="1">
          <mxGeometry x="390" y="1240" width="440" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n_decline" value="&lt;b&gt;&lt;font color=&quot;#E11D48&quot;&gt;Short, polite decline&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;No over-explaining. Redirects to cars.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#FFEDF1;strokeColor=#F6BFCD;" vertex="1" parent="1">
          <mxGeometry x="170" y="1340" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_toollayer" value="&lt;b&gt;&lt;font color=&quot;#059669&quot;&gt;Tool-calling layer&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Routes to one of five tools below.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#E9F8F1;strokeColor=#B9E6CF;" vertex="1" parent="1">
          <mxGeometry x="630" y="1340" width="420" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n_t1" value="&lt;b&gt;&lt;font color=&quot;#059669&quot;&gt;search_cars&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Chroma metadata filter &#8594; BM25 + semantic &#8594; RRF fusion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#E9F8F1;strokeColor=#B9E6CF;" vertex="1" parent="1">
          <mxGeometry x="55" y="1460" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_t2" value="&lt;b&gt;&lt;font color=&quot;#059669&quot;&gt;search_history&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Keyword match over car_interaction_log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#E9F8F1;strokeColor=#B9E6CF;" vertex="1" parent="1">
          <mxGeometry x="280" y="1460" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_t3" value="&lt;b&gt;&lt;font color=&quot;#059669&quot;&gt;manage_favorite&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;action: add / remove &#8212; writes an event_type=&quot;favorited&quot; row&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#E9F8F1;strokeColor=#B9E6CF;" vertex="1" parent="1">
          <mxGeometry x="505" y="1460" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_t4" value="&lt;b&gt;&lt;font color=&quot;#059669&quot;&gt;manage_booking&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;action: create / reschedule / cancel &#8212; Mon&#8211;Sat 8am&#8211;8pm check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#E9F8F1;strokeColor=#B9E6CF;" vertex="1" parent="1">
          <mxGeometry x="730" y="1460" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_t5" value="&lt;b&gt;&lt;font color=&quot;#059669&quot;&gt;qualify_lead&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Trigger condition still open (e.g. budget + 1 preference known)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#E9F8F1;strokeColor=#B9E6CF;" vertex="1" parent="1">
          <mxGeometry x="955" y="1460" width="210" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n_d1" value="&lt;b&gt;&lt;font color=&quot;#2563EB&quot;&gt;Chroma &quot;cars&quot;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Read-only lookup &#8212; never written to during a chat turn.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#EAF1FF;strokeColor=#BCD2FB;" vertex="1" parent="1">
          <mxGeometry x="55" y="1610" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_d2" value="&lt;b&gt;&lt;font color=&quot;#2563EB&quot;&gt;SQLite: car_interaction_log&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;read&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#EAF1FF;strokeColor=#BCD2FB;" vertex="1" parent="1">
          <mxGeometry x="280" y="1610" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_d3" value="&lt;b&gt;&lt;font color=&quot;#2563EB&quot;&gt;SQLite: car_interaction_log&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;write (favorited)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#EAF1FF;strokeColor=#BCD2FB;" vertex="1" parent="1">
          <mxGeometry x="505" y="1610" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_d4" value="&lt;b&gt;&lt;font color=&quot;#2563EB&quot;&gt;SQLite: bookings&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;listing_id, user_id, date, time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#EAF1FF;strokeColor=#BCD2FB;" vertex="1" parent="1">
          <mxGeometry x="730" y="1610" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_d5" value="&lt;b&gt;&lt;font color=&quot;#2563EB&quot;&gt;leads.csv&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Shared, all users, append-only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#EAF1FF;strokeColor=#BCD2FB;" vertex="1" parent="1">
          <mxGeometry x="955" y="1610" width="210" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n_narrate" value="&lt;b&gt;&lt;font color=&quot;#7C3AED&quot;&gt;LLM narrates the final answer&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Only from returned tool data &#8212; never outside/general knowledge. If selected_car changed this turn: &quot;Want me to save this to your favorites?&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#F4EFFF;strokeColor=#D9C9FB;" vertex="1" parent="1">
          <mxGeometry x="330" y="1750" width="560" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n_dualwrite" value="&lt;b&gt;&lt;font color=&quot;#D97706&quot;&gt;Dual-write state changes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;Chroma is never written to here &#8212; memory system only.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#FFF4E5;strokeColor=#F6D9A8;" vertex="1" parent="1">
          <mxGeometry x="330" y="1900" width="560" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n_json" value="&lt;b&gt;&lt;font color=&quot;#D97706&quot;&gt;session_cache.json &#8212; short-term&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;&#8226; recent_logs &#8212; updated if a preference changed, FIFO &#8804;6&lt;br&gt;&#8226; car_stack &#8212; all cars search_cars just returned, FIFO &#8804;6&lt;br&gt;&#8226; selected_car &#8212; updated only if narrowed to one car this turn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#FFF4E5;strokeColor=#F6D9A8;" vertex="1" parent="1">
          <mxGeometry x="170" y="2010" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n_sqlprofile" value="&lt;b&gt;&lt;font color=&quot;#2563EB&quot;&gt;SQLite user profile &#8212; long-term&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56607A&quot; style=&quot;font-size:10px&quot;&gt;1. username&lt;br&gt;2. filters (mirrors active filters)&lt;br&gt;3. selected_car (persisted &#8212; survives into a new session)&lt;br&gt;4. car_interaction_log &#8212; one unified table: user_id, listing_id, timestamp, event_type (shown/selected/favorited), reason&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;strokeWidth=1.5;fillColor=#EAF1FF;strokeColor=#BCD2FB;" vertex="1" parent="1">
